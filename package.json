{
  "name": "heating-controller-card",
  "version": "0.1.0",
  "description": "Dashboard card for the heating-controller Home Assistant integration",
  "type": "module",
  "license": "MIT",
  "author": "gitgud187",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitgud187/heating-controller-card.git"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.10",
    "eslint": "10.15.0",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
